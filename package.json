{
    "name": "@bejibun/x402",
    "version": "0.2.11",
    "author": "Havea Crenata <havea.crenata@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Bejibun-Framework/bejibun-x402.git"
    },
    "main": "index.js",
    "module": "index.js",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bun": "^1.3.14",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.11.0",
        "prettier": "^3.9.6",
        "tsc-alias": "^1.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0"
    },
    "bugs": {
        "url": "https://github.com/Bejibun-Framework/bejibun-x402/issues"
    },
    "description": "x402 Protocol for Bejibun Framework",
    "homepage": "https://github.com/Bejibun-Framework/bejibun-x402#readme",
    "keywords": [
        "bun",
        "bun framework",
        "x402",
        "bejibun",
        "typescript"
    ],
    "license": "MIT",
    "scripts": {
        "alias": "tsc-alias -p tsconfig.json",
        "types": "cp -rf src/types dist",
        "rsync": "rsync -a dist/ ./",
        "clean": "rm -rf dist",
        "format": "prettier --write src --log-level=silent",
        "eslint": "eslint src",
        "lint": "bun run format && bun run eslint",
        "build": "bun run lint && tsc -p tsconfig.json && bun run types && bun run alias && bun run rsync && bun run clean",
        "deploy": "bun run build && bun publish --access public"
    },
    "type": "module",
    "types": "index.d.ts",
    "dependencies": {
        "@bejibun/app": "^0.1.25",
        "@bejibun/logger": "^0.1.23",
        "@bejibun/utils": "^0.1.29",
        "@coinbase/x402": "^2.1.0",
        "@x402/core": "^2.23.0",
        "@x402/evm": "^2.23.0",
        "@x402/svm": "^2.23.0"
    }
}
